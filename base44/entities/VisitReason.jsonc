{
  "name": "VisitReason",
  "type": "object",
  "description": "A purpose a visitor can give for their visit; drives the kiosk dropdown.",
  "properties": {
    "label": {
      "type": "string",
      "description": "Shown to the visitor; unique among active reasons"
    },
    "icon": {
      "type": "string",
      "default": "users"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "label"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}