{
  "name": "AuditLog",
  "type": "object",
  "description": "Append-only record of every staff action on visitor data.",
  "properties": {
    "actor_email": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "export",
        "login",
        "settings_change"
      ]
    },
    "entity": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "summary"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}