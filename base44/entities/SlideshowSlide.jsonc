{
  "name": "SlideshowSlide",
  "type": "object",
  "description": "One slide of the kiosk sign-in slideshow.",
  "properties": {
    "eyebrow": {
      "type": "string",
      "description": "Small gold line above the title"
    },
    "title": {
      "type": "string",
      "description": "Headline; wrap key words in *asterisks* for italic gold emphasis"
    },
    "subtitle": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Direct image URL for the slide background"
    },
    "image_alt": {
      "type": "string"
    },
    "credit": {
      "type": "string",
      "description": "Image credit"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "duration_seconds": {
      "type": "number",
      "default": 6
    }
  },
  "required": [
    "image_url"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}